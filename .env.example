# 必须填写服务实际提供的模型 ID。库本身不隐式加载 .env；CLI 会加载本目录的 .env。
LLM_PROVIDER=deepseek
LLM_MODEL_ID=your-model-id
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 也支持 DEEPSEEK_API_KEY、OPENAI_API_KEY、MODELSCOPE_API_KEY、ZHIPU_API_KEY。
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_STEPS=5
LLM_MAX_HISTORY_LENGTH=100
# LLM_MAX_TOKENS=2048
# 在线搜索为可选功能；不配置时仍可使用计算器和离线示例。
# TAVILY_API_KEY=
